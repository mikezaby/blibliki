{
  "extends": [
    {
      "registry": "github:mikezaby/hal-rules/registry"
    }
  ],
  "skills": { "research/manual-analyzer": "on" },
  "rules": {
    "git/worktrees-by-default": ["on", { "worktreesDir": ".worktrees" }],
    "workflow/before-finish": [
      "on",
      {
        "checks": ["pnpm tsc", "pnpm lint", "pnpm test", "pnpm format:check"]
      }
    ],
    "workflow/out-of-scope-findings": [
      "on",
      {
        "findingsFile": "docs/findings.md"
      }
    ],
    "documentation/architecture-decisions": [
      "on",
      {
        "adrDir": "docs/adr/"
      }
    ]
  }
}
