# Firestore is where the instrument list comes from. Same project as apps/grid,
# so these can be copied from apps/grid/.env. Read-only: the app never writes
# an instrument back, it keeps edits as a device draft.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
