{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blibliki-grid",
  "compatibility_date": "2026-09-01",
  // Static assets only, no Worker code: every path that is not a file gets
  // index.html, which is what the Netlify redirect used to do. The JSON under
  // /api keeps its content type from the file extension.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // wrangler creates the DNS record and certificate on deploy. www is not a
  // route: it is a redirect rule in the zone, see scripts/README.md.
  "routes": [{ "pattern": "blibliki.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
}
